<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extensión del formulario de clientes -->
    <record id="view_partner_form_loyalty" model="ir.ui.view">
        <field name="name">res.partner.form.loyalty</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Agregamos una pestaña "Fidelidad" -->
            <notebook position="inside">
                <page string="Fidelidad">
                    <group>
                        <!-- Campo correcto según tu modelo Python -->
                        <field name="vape_available_points" readonly="1" string="Puntos Disponibles"/>
                    </group>

                    <group>
                        <field name="vape_loyalty_moves_ids" nolabel="1">
                            <list string="Movimientos de Puntos">
                                <field name="company_id"/>
                                <field name="points"/>
                                <field name="remaining"/>
                                <field name="expiry_date"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_loyalty_move" model="ir.actions.act_window">
        <field name="name">Movimientos de Puntos</field>
        <field name="res_model">vape.loyalty.point.move</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú para acceder a los movimientos -->
    <menuitem
        id="menu_loyalty_root"
        name="Puntos de Fidelidad"
        sequence="10"
        parent="contacts.menu_contacts"
        action="action_loyalty_move"
    />
</odoo>
