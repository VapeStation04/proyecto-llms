<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista tipo lista -->
    <record id="view_loyalty_move_list" model="ir.ui.view">
        <field name="name">vape.loyalty.point.move.list</field>
        <field name="model">vape.loyalty.point.move</field>
        <field name="arch" type="xml">
            <list string="Movimientos de Puntos de Fidelidad">
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="points"/>
                <field name="expiry_date"/>
                <field name="remaining"/>
                <field name="state"/>
                <field name="origin_model"/>
                <field name="origin_ref"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_loyalty_move_form" model="ir.ui.view">
        <field name="name">vape.loyalty.point.move.form</field>
        <field name="model">vape.loyalty.point.move</field>
        <field name="arch" type="xml">
            <form string="Movimiento de Puntos de Fidelidad">
                <group>
                    <field name="partner_id"/>
                    <field name="company_id"/>
                    <field name="points"/>
                    <field name="expiry_date"/>
                    <field name="remaining" readonly="1"/>
                    <field name="state"/>
                    <field name="origin_model"/>
                    <field name="origin_ref"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_loyalty_move" model="ir.actions.act_window">
        <field name="name">Movimientos de Puntos</field>
        <field name="res_model">vape.loyalty.point.move</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Aquí puedes ver todos los movimientos de puntos de fidelidad (ganados, consumidos, expirados, etc.).</p>
        </field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_loyalty_root"
              name="Puntos de Fidelidad"
              sequence="10"/>

    <menuitem id="menu_loyalty_move"
              name="Movimientos de Puntos"
              parent="menu_loyalty_root"
              action="action_loyalty_move"
              sequence="20"/>
</odoo>
