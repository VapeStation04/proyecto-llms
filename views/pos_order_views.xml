<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_tree_inherit_vape" model="ir.ui.view">
        <field name="name">pos.order.tree.inherit.vape</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='state']" position="after">
                <field name="vs_channel_id" optional="show"/>
                <field name="vs_shipping_type_id" optional="hide"/>
                <field name="vape_payment_methods" optional="show"/>
            </xpath>
            
        </field>
    </record>

    <record id="view_pos_pos_form_inherit_vape" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.vape</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="vs_channel_id" readonly="state == 'invoiced'"/>
            </xpath>

        </field>
    </record>
</odoo>