<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_vape_channel" model="ir.actions.act_window">
        <field name="name">Canales de Venta</field>
        <field name="res_model">vape.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="vape_channel_view_list" model="ir.ui.view">
        <field name="name">vape.channel.list</field>
        <field name="model">vape.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="icon" placeholder="ej. fa-whatsapp"/>
                <field name="custom_icon" widget="image" options="{'size': [35, 35]}"/>
                <field name="pos_config_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="vape_channel_view_form" model="ir.ui.view">
        <field name="name">vape.channel.form</field>
        <field name="model">vape.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color"/>
                        <field name="icon" placeholder="ej. fa-whatsapp"/>
                        <field name="custom_icon" widget="image" options="{'size': [35, 35]}"/>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_vape_channel"
              name="Canales de Venta"
              parent="point_of_sale.menu_point_config_product"
              action="action_vape_channel"
              sequence="100"/>
</odoo>