<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_vape_shipping_type" model="ir.actions.act_window">
        <field name="name">Tipos de Envío</field>
        <field name="res_model">vape.shipping.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="vape_shipping_type_view_list" model="ir.ui.view">
        <field name="name">vape.shipping.type.list</field>
        <field name="model">vape.shipping.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pos_config_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="vape_shipping_type_view_form" model="ir.ui.view">
        <field name="name">vape.shipping.type.form</field>
        <field name="model">vape.shipping.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="name"/>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_vape_shipping_type"
              name="Tipos de Envío"
              parent="point_of_sale.menu_point_config_product"
              action="action_vape_shipping_type"
              sequence="101"/>
</odoo>