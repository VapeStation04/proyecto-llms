<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="vape_pos_order_fields.CustomMenuButton" owl="1">
        <div class="button d-flex justify-content-between align-items-center w-100 mb-2" 
             t-on-click="onClick"
             style="background-color: #ffffff; border-radius: 8px; padding: 15px; border: 1px solid #dee2e6; cursor: pointer;">
            
            <div class="payment-name m-0" style="font-weight: bold; font-size: 16px;">
                <i t-attf-class="fa #{icon} me-2" role="img"/>
                <t t-esc="label"/>
            </div>
            <i class="fa fa-chevron-right text-muted"/>
            
        </div>
    </t>

</templates>